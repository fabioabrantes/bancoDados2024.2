generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Book {
  id              String   @id @default(uuid())
  author          String
  title           String
  descriptionType String   @map("description_type")
  userId          String
  users           User     @relation(fields: [userId], references: [id])
  createAt        DateTime @default(now())

  @@map("books")
}

model User {
  id    String  @id @default(uuid())
  cpf   String  @unique
  name  String
  email String?
  books Book[]

  @@map("users")
}
